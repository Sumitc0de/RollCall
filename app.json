{
  "expo": {
    "name": "RollCall",
    "slug": "rollcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rollcall",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.sumit.rollcall",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sumit.rollcall",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f7fbd636-33d3-4c35-9db1-f22c581546ab"
      }
    }
  }
}
